# Application
FRONTEND_HOST_PORT=7448
BACKEND_HOST_PORT=5000
IMAGE_TAG=latest
REACT_APP_API_URL=/api
CORS_ORIGINS=http://localhost:7448

# Generate strong unique values for production.
JWT_SECRET=replace-with-a-long-random-secret

# MongoDB. The backend uses the restricted application credentials.
MONGO_DATABASE=project_tracker
MONGO_ROOT_USERNAME=project_tracker_admin
MONGO_ROOT_PASSWORD=replace-with-a-long-random-password
MONGO_APP_USERNAME=project_tracker_app
MONGO_APP_PASSWORD=replace-with-a-different-long-random-password
MONGO_URI=mongodb://project_tracker_app:replace-with-a-different-long-random-password@mongodb:27017/project_tracker?authSource=project_tracker
