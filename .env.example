# Application
FRONTEND_HOST_PORT=7448
BACKEND_HOST_PORT=7449
IMAGE_TAG=latest
VITE_API_URL=/api
CORS_ORIGINS=http://localhost:7448

# Generate strong unique values for production.
JWT_SECRET=replace-with-a-long-random-secret

# PostgreSQL. The backend uses this connection string.
POSTGRES_DB=project_tracker
POSTGRES_USER=project_tracker_app
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://project_tracker_app:replace-with-a-long-random-password@postgres:5432/project_tracker
